a2 = 8
Step 7: Find a1
a1 + 3a2 = -4
a1 + 3(8) = -4
a1 + 24 = -4
a1 = -28
Step 8: Find a0
a0 + a1 + a2 = 4
a0 - 28 + 8 = 4
a0 - 20 = 4
